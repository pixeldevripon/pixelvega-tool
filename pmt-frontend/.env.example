# Copy this file to .env.local for local development.
#
# Do NOT put secrets in a NEXT_PUBLIC_* variable: Next.js inlines them into the
# browser bundle, where anyone can read them.

# Base URL of the PMT backend API.
#
# Port 5050, which is the BACKEND. The dashboard itself runs on 3000. This file
# used to point at the frontend's own port, so a fresh clone had the dashboard
# calling itself and every request 404'd against Next's router.
NEXT_PUBLIC_API_URL="http://localhost:5050"
