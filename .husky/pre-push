#!/usr/bin/env sh
# ──────────────────────────────────────────────────────────────────────────────
# Pre-push guard: mirror CI locally so a push never fails GitHub Actions after
# the fact. Cheapest checks first so it fails fast.
#
#   1. prisma generate  - backend lint/typecheck/test need the generated client
#   2. lint             - both packages
#   3. typecheck        - both packages (tsc --noEmit)
#   4. test             - backend Jest (mocked, no DB) + frontend Vitest
#   5. build            - backend nest build, then frontend next build
#
# Skip in a genuine emergency:  git push --no-verify
# ──────────────────────────────────────────────────────────────────────────────
set -e

echo "==> [1/5] Prisma client (backend types)..."
pnpm prisma:generate

echo "==> [2/5] Lint (backend + frontend)..."
pnpm lint

echo "==> [3/5] Typecheck (backend + frontend)..."
pnpm typecheck

echo "==> [4/5] Unit tests (backend + frontend)..."
pnpm test

echo "==> [5/5] Build (backend + frontend)..."
pnpm build

echo "==> All pre-push checks passed. Pushing."
