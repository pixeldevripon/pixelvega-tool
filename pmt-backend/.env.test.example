# Copy to .env.test for the E2E suite:  cp .env.test.example .env.test
#
# NEVER point DATABASE_URL at your development or production database. The E2E
# suite writes to and truncates real tables. test/global-setup.js refuses to run
# when this value matches the DATABASE_URL in .env, including when only the
# credentials differ.

NODE_ENV=test
PORT=3099

# A dedicated database. Create it first:  createdb pixelvega_test
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pixelvega_test"

# Fixed test secret. At least 32 characters.
BETTER_AUTH_SECRET="test-only-secret-not-used-anywhere-real!!"
BETTER_AUTH_URL="http://localhost:3099"

# CORS_ORIGINS, plural. This file previously said CORS_ORIGIN, which nothing
# reads, so better-auth ran with an EMPTY trusted origin list under test while
# production had a real one. The suites still passed because supertest sends no
# Origin header, which is exactly how a difference like this survives.
CORS_ORIGINS="http://localhost:3000"
APP_URL="http://localhost:3000"

# The bootstrap SYSTEM_ADMIN created on first boot against an empty database.
SEED_ADMIN_EMAIL="admin@pixelvega.test"
SEED_ADMIN_NAME="Test System Admin"

# Optional in tests. Every one of these features no-ops without its key, and the
# specs mock the provider rather than reaching a real service.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="noreply@pixelvega.test"
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SLACK_BOT_TOKEN=
SLACK_DAILY_FEED_CHANNEL_ID=
ANTHROPIC_API_KEY=
REDIS_URL=
INTERNAL_API_SECRET=
AUTH_DISABLE_ORIGIN_CHECK=
