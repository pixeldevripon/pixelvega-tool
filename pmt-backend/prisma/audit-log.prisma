// prisma/audit-log.prisma
//
// Append only record of who did what.

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([targetType, targetId])
}
