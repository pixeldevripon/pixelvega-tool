// prisma/user.prisma
//
// Better Auth identity plus the two 1:1 profile extensions.

model User {
  id                String     @id @default(uuid())
  email             String     @unique
  emailVerified     Boolean    @default(false)
  password          String? // managed by better-auth via Account, not used directly

  /**
   * `name` is the full name every other table, email and audit row reads, and
   * it stays the authoritative one. firstName and lastName are the two halves
   * the account screen edits, and the two representations are kept in step by
   * `common/utils/name.util.ts`: writing either half recomposes `name`, and
   * writing `name` (an admin, through PATCH /users/:userId) re-splits it. Both
   * doors therefore leave the row consistent, which is why `name` is not simply
   * derived at read time: 30-odd queries select it and none of them should have
   * to know it is computed.
   */
  name      String
  firstName String?
  lastName  String?

  /** ISO 3166-1 alpha-2. Not an enum: the list belongs to a standard that
   *  changes without a schema migration, and 249 members in a Postgres enum is
   *  a type nobody can alter safely. `common/constants/countries.ts` is the
   *  allowlist and the source of the labels. */
  country String?
  gender  Gender?

  /**
   * Personal links, in the order the person arranged them, bounded by the DTO.
   * A scalar list rather than a table because there is nothing else to say
   * about one: no label, no verification, no per-row permission. A join table
   * would buy ordering, and `String[]` already has it.
   */
  socialUrls String[] @default([])

  avatarUrl         String?
  avatarPublicId    String? // Cloudinary public_id, used to delete the old asset on replace
  slackUserId       String? // cached from users.lookupByEmail on first successful resolution
  role              Role       @default(DEVELOPER)
  status            UserStatus @default(INVITED)
  mustResetPassword Boolean    @default(true)

  createdById  String?
  createdBy    User?   @relation("UserInvites", fields: [createdById], references: [id])
  invitedUsers User[]  @relation("UserInvites")

  sessions           Session[]
  accounts           Account[]
  auditLogs          AuditLog[]
  employeeProfile    EmployeeProfile?
  clientProfile      ClientProfile?
  leaveRequests      LeaveRequest[]      @relation("LeaveRequestRequester")
  reviewedLeaves     LeaveRequest[]      @relation("LeaveRequestReviewer")
  leaveBalances      LeaveBalance[]
  projectsAsClient   Project[]           @relation("ProjectClient")
  projectsCreated    Project[]           @relation("ProjectCreatedBy")
  projectActivities  ProjectActivity[]
  projectMemberships ProjectMember[]
  uploadedDocuments  ProjectDocument[]
  timeEntries        TimeEntry[]
  meetingTimeEntries MeetingTimeEntry[]
  uploadedAdditionalRequirements AdditionalRequirement[] @relation("AdditionalReqUploader")
  reviewedAdditionalRequirements AdditionalRequirement[] @relation("AdditionalReqReviewer")
  dailyWorkReports               DailyWorkReport[]       @relation("WorkReportAuthor")
  reviewedProjectEntries         DailyProjectEntry[]      @relation("ProjectEntryReviewer")
  reportedBlockers               Blocker[]               @relation("BlockerReportedBy")
  resolvedBlockers               Blocker[]               @relation("BlockerResolvedBy")
  assignedBlockers               Blocker[]               @relation("BlockerAssignedTo")
  internalReviewsGiven           ProjectInternalReview[]  @relation("ProjectInternalReviewReviewer")
  clientFeedbackGiven            ClientFeedback[]         @relation("ClientFeedbackClient")
  clientFeedbackRecorded         ClientFeedback[]         @relation("ClientFeedbackRecordedBy")
  requestedAiJobs                AiJob[]
  createdAiTemplates             AiTemplate[]
  requestedStatusReports         ProjectStatusReport[]
  notifications                  Notification[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([role])
  @@index([status])
}


// One per User with role ADMIN | PROJECT_MANAGER | DEVELOPER | DESIGNER, created at invite time.
model EmployeeProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  designation        String?
  phone              String?
  timezone           String?
  bio                String?
  currentStatus      EmployeeWorkStatus @default(WORKING)
  availabilityStatus AvailabilityStatus @default(AVAILABLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// One per User with role CLIENT, created at invite or account creation time.
model ClientProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName  String?
  billingEmail String?
  phone        String?
  timezone     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// Session, Account, Verification below are the tables better-auth needs.
// Run `npx auth@latest generate --config src/auth/auth.instance.ts` to have
// better-auth generate or confirm the exact shape of these three models.
// Do not write their fields by hand; use the CLI output and paste it in here.
model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}


model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}


model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}


