// prisma/schema.prisma
//
// Generator and datasource only. Every model and enum lives in a domain file
// alongside this one, and Prisma 7 merges the whole folder automatically
// (prisma.config.ts points `schema` at 'prisma/'). Directive D3.
//
//   enums.prisma           Every enum in the schema. Kept together, matching the reference backend.
//   user.prisma            Better Auth identity plus the two 1:1 profile extensions.
//   audit-log.prisma       Append only record of who did what.
//   leave.prisma           Leave types, holidays, requests and per year balances.
//   projects.prisma        The core project entity, its staffing history, type tags and activity log.
//   documents.prisma       Project documents: uploaded files and typed text.
//   time-tracking.prisma   Project and meeting time segments.
//   work-reports.prisma    Daily plan and wrap up reporting.
//   blockers.prisma        Real time blockers and their PM managed reasons.
//   reviews.prisma         Additional requirements, internal review and client feedback.
//   ai.prisma              Queued AI jobs, prompt templates and saved status reports.
//   notifications.prisma   Per recipient in app notifications.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
