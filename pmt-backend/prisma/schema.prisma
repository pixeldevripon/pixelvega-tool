// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum Role {
  SYSTEM_ADMIN
  ADMIN
  PROJECT_MANAGER
  DEVELOPER
  DESIGNER
  CLIENT
}

enum EmployeeWorkStatus {
  WORKING
  ON_LEAVE
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  UNAVAILABLE
}

model User {
  id                String     @id @default(uuid())
  email             String     @unique
  emailVerified     Boolean    @default(false)
  password          String? // managed by better-auth via Account, not used directly
  name              String
  avatarUrl         String?
  avatarPublicId    String? // Cloudinary public_id, used to delete the old asset on replace
  slackUserId       String? // cached from users.lookupByEmail on first successful resolution
  role              Role       @default(DEVELOPER)
  status            UserStatus @default(INVITED)
  mustResetPassword Boolean    @default(true)

  createdById  String?
  createdBy    User?   @relation("UserInvites", fields: [createdById], references: [id])
  invitedUsers User[]  @relation("UserInvites")

  sessions           Session[]
  accounts           Account[]
  resetCodes         PasswordResetCode[]
  auditLogs          AuditLog[]
  employeeProfile    EmployeeProfile?
  clientProfile      ClientProfile?
  leaveRequests      LeaveRequest[]      @relation("LeaveRequestRequester")
  reviewedLeaves     LeaveRequest[]      @relation("LeaveRequestReviewer")
  leaveBalances      LeaveBalance[]
  projectsAsClient   Project[]           @relation("ProjectClient")
  projectsCreated    Project[]           @relation("ProjectCreatedBy")
  projectActivities  ProjectActivity[]
  projectMemberships ProjectMember[]
  uploadedDocuments  ProjectDocument[]
  timeEntries        TimeEntry[]
  meetingTimeEntries MeetingTimeEntry[]
  uploadedAdditionalRequirements AdditionalRequirement[] @relation("AdditionalReqUploader")
  reviewedAdditionalRequirements AdditionalRequirement[] @relation("AdditionalReqReviewer")
  dailyWorkReports               DailyWorkReport[]       @relation("WorkReportAuthor")
  reviewedProjectEntries         DailyProjectEntry[]      @relation("ProjectEntryReviewer")
  reportedBlockers               Blocker[]               @relation("BlockerReportedBy")
  resolvedBlockers               Blocker[]               @relation("BlockerResolvedBy")
  assignedBlockers               Blocker[]               @relation("BlockerAssignedTo")
  internalReviewsGiven           ProjectInternalReview[]  @relation("ProjectInternalReviewReviewer")
  clientFeedbackGiven            ClientFeedback[]         @relation("ClientFeedbackClient")
  clientFeedbackRecorded         ClientFeedback[]         @relation("ClientFeedbackRecordedBy")
  requestedAiJobs                AiJob[]
  createdAiTemplates             AiTemplate[]
  requestedStatusReports         ProjectStatusReport[]
  notifications                  Notification[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([role])
  @@index([status])
}

// One per User with role ADMIN | PROJECT_MANAGER | DEVELOPER | DESIGNER, created at invite time.
model EmployeeProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  designation        String?
  phone              String?
  timezone           String?
  bio                String?
  currentStatus      EmployeeWorkStatus @default(WORKING)
  availabilityStatus AvailabilityStatus @default(AVAILABLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One per User with role CLIENT, created at invite or account creation time.
model ClientProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName  String?
  billingEmail String?
  phone        String?
  timezone     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Session, Account, Verification below are the tables better-auth needs.
// Run `npx auth@latest generate --config src/auth/auth.instance.ts` to have
// better-auth generate or confirm the exact shape of these three models.
// Do not write their fields by hand; use the CLI output and paste it in here.
model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model PasswordResetCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([targetType, targetId])
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// Reference data, e.g. "Annual Leave", "Sick Leave". ADMIN manages, everyone reads.
model LeaveType {
  id                 String   @id @default(uuid())
  name               String   @unique
  defaultDaysPerYear Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]
}

// Holidays that apply company wide. ADMIN manages, everyone reads.
// A holiday can span one or more days. For a holiday that spans a single
// day, startDate and endDate are the same date.
model Holiday {
  id        String   @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, startDate])
}

model LeaveRequest {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation("LeaveRequestRequester", fields: [userId], references: [id])
  leaveTypeId  String
  leaveType    LeaveType   @relation(fields: [leaveTypeId], references: [id])
  startDate    DateTime
  endDate      DateTime
  days         Int
  reason       String?
  status       LeaveStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?       @relation("LeaveRequestReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId])
  @@index([status])
}

// One row per (user, leaveType, year). Created lazily on first read/use.
// There's no cron job, and nothing carries over from one year to the next.
model LeaveBalance {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  leaveTypeId   String
  leaveType     LeaveType @relation(fields: [leaveTypeId], references: [id])
  year          Int
  allocatedDays Int
  usedDays      Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, leaveTypeId, year])
}

// ---------------------------------------------------------------------------
// Project management
// ---------------------------------------------------------------------------

enum ProjectStatus {
  PLANNING
  SCHEDULED
  READY_FOR_WORK
  IN_PROGRESS
  ON_HOLD
  INTERNAL_REVIEW
  READY_FOR_CLIENT
  WAITING_FOR_FEEDBACK
  COMPLETED
  CANCELLED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
  CRITICAL
}

enum ProjectType {
  WORDPRESS
  WEBFLOW
  WIX
  FRAMER
  FIGMA
  MERN_STACK
  SEO
}

// Mirrors the staff subset of Role one to one (PROJECT_MANAGER/DEVELOPER/
// DESIGNER). A ProjectMember's role must match the user's actual global
// Role, enforced in ProjectMembersService's ALLOWED_GLOBAL_ROLES map. Kept
// as its own enum, rather than reusing Role directly, since a project team
// slot is a narrower concept scoped to a project, unlike the global Role
// column.
enum ProjectRole {
  PROJECT_MANAGER
  DEVELOPER
  DESIGNER
}

// Scoped to activity types the app can actually produce today. Extend this
// enum as documents, time tracking, standups, etc. land.
enum ProjectActivityType {
  PROJECT_CREATED
  PROJECT_DETAILS_UPDATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  DEADLINE_CHANGED
  PROJECT_TYPES_CHANGED
  MEMBER_JOINED
  MEMBER_LEFT
  DOCUMENT_ADDED
  DOCUMENT_UPDATED
  DOCUMENT_REMOVED
  TIME_STARTED
  TIME_PAUSED
  TIME_RESUMED
  TIME_STOPPED
  TIME_AUTO_STOPPED
  ESTIMATED_HOURS_CHANGED
  ADDITIONAL_REQUIREMENT_ADDED
  ADDITIONAL_REQUIREMENT_REVIEWED
  PROJECT_COMPLETED
  PROJECT_CANCELLED
  PROJECT_ARCHIVED
  PROJECT_RESTORED
  PLAN_SUBMITTED
  PLAN_UPDATED
  WRAP_UP_SUBMITTED
  WRAP_UP_UPDATED
  WORK_REPORT_REVIEWED
  BLOCKER_ADDED
  BLOCKER_STATUS_CHANGED
  BLOCKER_ASSIGNED
  INTERNAL_FEEDBACK_RECEIVED
  CLIENT_FEEDBACK_RECEIVED
  AI_STATUS_REPORT_GENERATED
}

// A project document is either typed text (e.g. a Credential, a quick note)
// or an uploaded file, never both. Only Admin/System Admin/Project Manager
// ever create, edit, or delete these. Developer/Designer are read only via
// the same active ProjectMember scoping as the rest of this module, and
// Client is restricted to DELIVERABLE type rows only, enforced in the
// service layer.
enum ProjectDocumentType {
  PRD
  REQUIREMENT
  MEETING_NOTE
  CREDENTIAL
  ASSET
  DELIVERABLE
}

enum ProjectDocumentFormat {
  TEXT // credentials, quick notes, typed directly with no file
  FILE // pdf, docx, image, zip, etc.
}

model Project {
  id          String          @id @default(uuid())
  name        String
  description String?
  status      ProjectStatus   @default(PLANNING)
  priority    ProjectPriority @default(MEDIUM)
  rushReason  String? // required when priority is set to URGENT or CRITICAL, enforced in service layer

  clientId    String
  client      User   @relation("ProjectClient", fields: [clientId], references: [id])
  createdById String
  createdBy   User   @relation("ProjectCreatedBy", fields: [createdById], references: [id])

  plannedStartDate DateTime?
  deadline         DateTime?
  completedAt      DateTime?

  onHoldReason       String?
  cancellationReason String?
  archivedAt         DateTime? // independent of status, a COMPLETED or CANCELLED project can both be archived

  estimatedHours Float? // manually set by PM/Admin (or assisted by AI later), no estimate by default
  actualHours    Float  @default(0) // recalculated as sum(durationMinutes)/60 across ended TimeEntry rows whenever a segment ends. remainingHours is derived on read (estimatedHours - actualHours), never stored

  slackChannelId String? // set once the private Slack channel is created; null until then / if creation failed

  projectTypeTags        ProjectTypeTag[]
  activities             ProjectActivity[]
  members                ProjectMember[]
  documents              ProjectDocument[]
  timeEntries            TimeEntry[]
  additionalRequirements AdditionalRequirement[]
  dailyProjectEntries    DailyProjectEntry[]
  blockers               Blocker[]
  internalReviews        ProjectInternalReview[]
  clientFeedback         ClientFeedback[]
  aiJobs                 AiJob[]
  statusReports          ProjectStatusReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([clientId])
}

// Only Admin, System Admin, or Project Manager ever create, edit, or delete
// these, enforced in ProjectDocumentsService, not just at the route level.
// Soft delete via deletedAt, the same pattern as User: history is
// preserved rather than removed. A FILE format document's underlying
// upload is immutable once created; editing only covers metadata (title,
// description, textContent), the same reason avatar upload is POST, not
// PATCH: replacing a file is a new upload that isn't idempotent, not an edit.
model ProjectDocument {
  id          String                @id @default(uuid())
  projectId   String
  project     Project               @relation(fields: [projectId], references: [id])
  description String?
  type        ProjectDocumentType
  format      ProjectDocumentFormat @default(FILE)
  title       String

  // FILE format
  fileUrl       String?
  fileMimeType  String? // "application/pdf", "image/png", "application/zip", etc.
  fileSizeBytes Int?

  // TEXT format, e.g. credentials, quick notes
  textContent String?

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([projectId])
  @@index([type])
}

// One row per membership stint. Adding a member always creates a new row;
// removing sets leftAt rather than deleting. Full history survives, and a
// user rejoining later gets a brand new row, not a reactivated old one.
// Only rows with leftAt = NULL count as active.
model ProjectMember {
  id        String      @id @default(uuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id])
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  role      ProjectRole

  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([userId])
  @@index([role])
  @@index([leftAt])
  @@index([projectId, leftAt])
}

model ProjectTypeTag {
  id        String      @id @default(uuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id])
  type      ProjectType

  createdAt DateTime @default(now())

  @@unique([projectId, type]) // a project can't be tagged the same type twice
  @@index([projectId])
}

// An immutable, typed timeline: the project's historical record. Never
// updated or deleted once written. Distinct from the generic AuditLog,
// which covers identity, leave, and system level events instead.
model ProjectActivity {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  userId    String?
  user      User?   @relation(fields: [userId], references: [id])

  type ProjectActivityType

  message  String?
  metadata Json?

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([projectId, createdAt])
  @@index([type])
}

enum TimeEntryStatus {
  RUNNING
  PAUSED
  STOPPED
}

// One row per running, paused, or stopped *segment*, not per whole work
// session. This follows the same append only philosophy as
// ProjectMember/ProjectActivity: pausing never mutates a row back into a
// "startable" state, it closes the segment (endedAt/durationMinutes set,
// status PAUSED) and resuming inserts a new row instead. sessionId groups a
// start plus all its pause/resume segments into one logical session; the
// first segment's sessionId equals its own id (generated in app code via
// randomUUID() so it's known before insert). "Only one active timer per
// person" is enforced in the service layer by checking for an existing row
// with status = RUNNING for that userId, across all projects. This is a
// global constraint, not one scoped to a project.
model TimeEntry {
  id        String          @id @default(uuid())
  projectId String
  project   Project         @relation(fields: [projectId], references: [id])
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  sessionId String
  status    TimeEntryStatus @default(RUNNING)
  notes     String?

  startedAt       DateTime  @default(now())
  endedAt         DateTime? // set when paused or stopped; null while RUNNING
  durationMinutes Int? // this segment's own elapsed minutes; set once endedAt is set

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([userId])
  @@index([userId, status])
  @@index([sessionId])
}

// A timer for time not spent on any project, office meetings for now
// (standups, planning, client calls not billed to a project). A sibling
// model to TimeEntry rather than a nullable projectId on it, since
// TimeEntry.projectId being required is relied on all over
// project-time-entries.service.ts. Shares the same segment shape and
// TimeEntryStatus enum so the pause/resume append only logic mirrors
// TimeEntry's nearly line for line. Meeting time never touches
// Project.actualHours or any project scoped report, and "only one timer of
// any kind at a time" is enforced in the service layer across both this
// table and TimeEntry.
model MeetingTimeEntry {
  id     String          @id @default(uuid())
  userId String
  user   User            @relation(fields: [userId], references: [id])
  sessionId String
  status    TimeEntryStatus @default(RUNNING)
  notes     String?

  startedAt       DateTime  @default(now())
  endedAt         DateTime? // set when paused or stopped; null while RUNNING
  durationMinutes Int? // this segment's own elapsed minutes; set once endedAt is set

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([sessionId])
}

enum AdditionalRequirementStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

// A requirement received outside the normal project scope (e.g. by email, a
// client phone call, or a marketplace platform like Upwork/Fiverr), logged
// here so a Project Manager can decide whether to fold it into the project.
// Approving one is additive on top of the project's current
// estimatedHours/deadline, never an absolute override.
// aiScopeAnalysis is reserved for an automatic comparison of whether this
// falls in or out of scope against the project's existing requirement
// documents. Not built yet, same as hour estimation assisted by AI on
// Project.estimatedHours.
model AdditionalRequirement {
  id              String                      @id @default(uuid())
  projectId       String
  project         Project                     @relation(fields: [projectId], references: [id])
  description     String
  sourceChannel   String? // "email", "upwork", "fiverr", "direct", free text
  aiScopeAnalysis Json?
  status          AdditionalRequirementStatus @default(PENDING_REVIEW)

  uploadedById String
  uploadedBy   User    @relation("AdditionalReqUploader", fields: [uploadedById], references: [id])
  reviewedById String?
  reviewedBy   User?   @relation("AdditionalReqReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  // Both additive, applied on top of the project's current values when
  // approved. Only meaningful when status is APPROVED.
  approvedAdditionalHours Float?
  deadlineExtensionDays   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Daily work reports (standup plan plus wrap up)
// ---------------------------------------------------------------------------

// DRAFT is unused in practice today. create() goes straight to
// PLAN_SUBMITTED, since submitting a plan is what creates the row at all.
// Kept as the enum's first value for forward compatibility (e.g. a future
// "save without submitting" flow) rather than removed.
enum DailyWorkReportStatus {
  DRAFT
  PLAN_SUBMITTED
  COMPLETED
}

// One row per (user, date), covering the day's plan then wrap up lifecycle,
// spanning however many projects that person touches that day. Plan is
// mandatory: submitWrapUp() rejects with 409 unless status is already
// PLAN_SUBMITTED, so a developer can never wrap up a day they never
// planned. Plan is editable anytime up to wrap up submission (a lock based
// on state, with no time limit); wrap up is editable for a fixed 2 hour
// window after wrapUpSubmittedAt (a lock based on time).
model DailyWorkReport {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("WorkReportAuthor", fields: [userId], references: [id])
  date   DateTime @db.Date

  status DailyWorkReportStatus @default(PLAN_SUBMITTED)

  planSubmittedAt   DateTime?
  wrapUpSubmittedAt DateTime?

  // ts of the one combined plan/wrap up message posted to
  // SLACK_DAILY_FEED_CHANNEL_ID for this report. One message per report,
  // covering every project entry at once, not one per project (that's what
  // planProjectSlackTs/wrapUpProjectSlackTs on each entry below are for).
  planFeedSlackTs   String?
  wrapUpFeedSlackTs String?

  entries DailyProjectEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

// One row per project touched on a given day's report. A row can exist with
// only `plan` set (planned but not yet wrapped up) or with both `plan` and
// `accomplishments` set (wrapped up). A row can also be created at wrap up
// time with `plan` left null though, for a project added at wrap up that
// wasn't part of the morning plan. That's allowed; only the report as a
// whole requires a plan to exist first, not every individual project entry.
model DailyProjectEntry {
  id                String          @id @default(uuid())
  dailyWorkReportId String
  dailyWorkReport   DailyWorkReport @relation(fields: [dailyWorkReportId], references: [id])
  projectId         String
  project           Project         @relation(fields: [projectId], references: [id])

  plan            String?
  accomplishments String?

  planProjectSlackTs   String? // ts of the plan message posted to the project's Slack channel
  wrapUpProjectSlackTs String? // ts of the wrap up message posted to the project's Slack channel
  // The combined ts for the feed channel lives on DailyWorkReport instead,
  // not here: one message per report covering all projects, not one per entry.

  reviewedById  String?
  reviewedBy    User?     @relation("ProjectEntryReviewer", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  reviewComment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dailyWorkReportId, projectId])
  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Real time blockers (independent of daily work reports)
// ---------------------------------------------------------------------------

enum BlockerStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum BlockerSeverity {
  LOW
  MEDIUM
  HIGH
}

// Reference data managed by Admin/PM, using the same soft delete pattern as
// User.deletedAt. A reason can be soft deleted after it's been used.
// Existing blockers keep referencing it (still readable); it just drops out
// of the picker for new blockers. The seeded "Unspecified" row is the
// fallback BlockerService assigns when a blocker is reported without an
// explicit reasonId, and is identified by name, not a dedicated column,
// since name is the only field here, so it's protected from rename and
// delete in BlockerReasonsService to keep that fallback working.
// Uniqueness on `name` is enforced by a partial unique index
// (WHERE deletedAt IS NULL) created directly in the migration SQL rather
// than a `@unique` here, since Prisma's schema DSL can't express a partial
// index. This is intentionally unmanaged by `prisma migrate diff`, matching
// this project's hand written migration workflow.
model BlockerReason {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  blockers Blocker[]
}

// This is completely independent of DailyWorkReport/DailyProjectEntry. It
// can be reported and resolved anytime, can span however many days it
// takes, and isn't scoped to a calendar date. Once RESOLVED it's locked and
// read only, the same terminal state convention as Project's
// COMPLETED/CANCELLED statuses. resolutionTime/daysOpen/
// causedDeadlineExtension are derived on read, not stored.
model Blocker {
  id          String          @id @default(uuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id])
  description String
  status      BlockerStatus   @default(OPEN)
  severity    BlockerSeverity @default(MEDIUM)

  reasonId String
  reason   BlockerReason @relation(fields: [reasonId], references: [id])

  reportedById String
  reportedBy   User   @relation("BlockerReportedBy", fields: [reportedById], references: [id])

  // Who is currently working the blocker. This is distinct from
  // reportedBy/resolvedBy, since ownership can change hands: the reporter
  // opens it, someone else takes it IN_PROGRESS, and a third person
  // resolves it.
  assignedToId String?
  assignedTo   User?     @relation("BlockerAssignedTo", fields: [assignedToId], references: [id])
  assignedAt   DateTime?

  resolvedById    String?
  resolvedBy      User?     @relation("BlockerResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt      DateTime?
  resolutionNotes String?

  // Additive on top of Project.deadline when set on resolve, the same
  // pattern as AdditionalRequirement.deadlineExtensionDays. It is never an
  // absolute override.
  deadlineExtensionDays Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
  @@index([reasonId])
  @@index([assignedToId])
}

// ---------------------------------------------------------------------------
// Internal review (QA gate before a project reaches the client)
// ---------------------------------------------------------------------------

enum InternalReviewDecision {
  APPROVED
  CHANGES_REQUIRED
}

// A Developer/Designer moves a project IN_PROGRESS -> INTERNAL_REVIEW once
// their work is ready. A Project Manager then reviews it here: APPROVED
// moves the project to READY_FOR_CLIENT, CHANGES_REQUIRED moves it back to
// READY_FOR_WORK. Rounds accumulate, never overwritten, the same pattern
// ClientFeedback will use later. reviewRound is unique per project, so the
// full history reads in order.
model ProjectInternalReview {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  reviewedById String
  reviewedBy   User   @relation("ProjectInternalReviewReviewer", fields: [reviewedById], references: [id])

  decision    InternalReviewDecision
  comments    String?
  reviewRound Int

  createdAt DateTime @default(now())

  @@unique([projectId, reviewRound])
  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Client feedback (client-facing counterpart to internal review)
// ---------------------------------------------------------------------------

enum ClientFeedbackDecision {
  APPROVED
  CHANGES_REQUESTED
}

// A round of client review. Only the first round for a project (created
// while status is WAITING_FOR_FEEDBACK) drives the project's status —
// APPROVED to COMPLETED, CHANGES_REQUESTED to READY_FOR_WORK, in
// ClientFeedbackService.create(). Every later round is accepted regardless
// of the project's current status (blocked only once COMPLETED/CANCELLED)
// and is commentary-only: it never moves the project again, so a developer
// actively IN_PROGRESS on the first round's decision is never interrupted
// by later client input. clientId is always the project's own assigned
// client (Project.clientId), even when a Project Manager records feedback
// the Client gave outside the system (email, phone, a marketplace platform)
// — recordedById is what distinguishes self-submitted (NULL) from
// PM-recorded. Rows accumulate and are never overwritten, the same pattern
// as ProjectInternalReview above.
model ClientFeedback {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  clientId String
  client   User   @relation("ClientFeedbackClient", fields: [clientId], references: [id])

  recordedById String?
  recordedBy   User?   @relation("ClientFeedbackRecordedBy", fields: [recordedById], references: [id])

  decision      ClientFeedbackDecision
  comments      String?
  feedbackRound Int

  createdAt DateTime @default(now())

  @@unique([projectId, feedbackRound])
  @@index([projectId])
}

// ---------------------------------------------------------------------------
// AI integration (scope checker, project summary, AI status report)
// ---------------------------------------------------------------------------

enum AiJobType {
  CHECK_SCOPE
  GENERATE_STATUS_REPORT
}

enum AiJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

// One row per queued piece of work across both async AI features (the scope
// checker and status report generation). Not used by the project summary,
// which stays a plain synchronous call. Created at QUEUED, updated by the
// processor to PROCESSING then COMPLETED/FAILED. resultRefId points at
// whatever the job actually produced (an AdditionalRequirement for a scope
// check, a ProjectStatusReport for a status report), not a foreign key
// since it can reference either table.
model AiJob {
  id            String      @id @default(uuid())
  type          AiJobType
  status        AiJobStatus @default(QUEUED)
  projectId     String?
  project       Project?    @relation(fields: [projectId], references: [id])
  requestedById String?
  requestedBy   User?       @relation(fields: [requestedById], references: [id])

  input        Json // whatever the job needs: period, requirementId, etc.
  resultRefId  String?
  errorMessage String?

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([projectId])
  @@index([type, status])
}

enum AiTemplateKind {
  PROJECT_SUMMARY
  STATUS_REPORT
}

// Reference data, managed the same way LeaveType/Holiday already are:
// Admin writes, every staff role reads. content is a structural outline,
// not the generated output itself, it goes directly into the system
// prompt as the required section structure. Exactly one row per kind can
// have isDefault true at a time, enforced by a partial unique index below
// (Prisma's schema DSL cannot express a partial index directly), the same
// approach BlockerReason uses for name uniqueness over non deleted rows.
model AiTemplate {
  id          String         @id @default(uuid())
  kind        AiTemplateKind
  name        String
  content     String // a structural outline for the summary or status report
  isDefault   Boolean        @default(false)
  createdById String
  createdBy   User           @relation(fields: [createdById], references: [id])
  statusReports ProjectStatusReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
}

enum StatusReportType {
  STATUS_UPDATE
}

// A fuller, saved version of the project summary (Feature 2), meant to be
// handed to a client or to leadership. A separate table from ProjectDocument
// on purpose, this has its own metadata (a period, a report type) that does
// not belong on the generic document model. Append only, the same pattern
// as ProjectMember/TimeEntry: regenerating one for the same period creates
// a new row rather than overwriting the last, so the full history survives.
// templateId is nullable only because a kind could theoretically have no
// current default at generation time (see AiTemplatesService.remove()'s
// own note on that gap), not because it is ever optional in the normal path.
model ProjectStatusReport {
  id            String   @id @default(uuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  requestedById String
  requestedBy   User     @relation(fields: [requestedById], references: [id])

  reportType  StatusReportType @default(STATUS_UPDATE)
  content     String // markdown
  periodStart DateTime
  periodEnd   DateTime
  model       String

  templateId String?
  template   AiTemplate? @relation(fields: [templateId], references: [id])

  createdAt DateTime @default(now())

  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

// One value per distinct event, never a generic bucket, see
// docs/features/notifications/DESIGN.md: "assigned to a new project" and
// "new requirement added to an existing project" must stay two separate
// types, for example, even though both could be described as "project
// updated." Who receives a given type is a recipient rule resolved by
// whichever service fires it, not baked into the type itself, the same
// event fans out into one row per recipient below.
enum NotificationType {
  PROJECT_CREATED
  MEMBER_ASSIGNED
  MEMBER_REMOVED
  MEMBER_REASSIGNED
  MEMBER_HANDOVER
  PROJECT_STATUS_CHANGED
  PROJECT_ON_HOLD
  PROJECT_CANCELLED
  PROJECT_PRIORITY_RAISED
  DOCUMENT_UPLOADED
  BLOCKER_ASSIGNED
  WORK_REPORT_COMMENTED
  STANDUP_MISSED
  WRAP_UP_MISSED
  DEADLINE_APPROACHING
  INTERNAL_REVIEW_SUBMITTED
  INTERNAL_REVIEW_CHANGES_REQUIRED
  PROJECT_READY_FOR_CLIENT
  CLIENT_FEEDBACK_APPROVED
  CLIENT_FEEDBACK_CHANGES_REQUESTED
  PROJECT_AUTO_COMPLETED
  ADDITIONAL_REQUIREMENT_SUBMITTED
  ADDITIONAL_REQUIREMENT_FLAGGED_OUT_OF_SCOPE
  ADDITIONAL_REQUIREMENT_APPROVED
  ADDITIONAL_REQUIREMENT_REJECTED
  ADDITIONAL_REQUIREMENT_HOURS_OR_DEADLINE_CHANGED
  LEAVE_REQUEST_SUBMITTED
  LEAVE_REQUEST_APPROVED
  LEAVE_REQUEST_REJECTED
}

// One row per recipient, unlike ProjectActivity (one row per project event,
// read by everyone with access). A notification is inherently per person,
// a PM's unread count is never the same number as their developer's, so
// the same event legitimately produces multiple rows here. Never deleted,
// same convention as ProjectActivity/AuditLog, readAt is the only
// lifecycle state a row ever gets. Always self scoped on read, a user only
// ever sees their own rows, no staff role sees anyone else's.
model Notification {
  id       String           @id @default(uuid())
  userId   String
  user     User             @relation(fields: [userId], references: [id])
  type     NotificationType
  title    String
  message  String?
  metadata Json? // projectId, blockerId, whatever the frontend needs to deep link
  readAt   DateTime? // null = unread

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, readAt])
}
