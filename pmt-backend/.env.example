# Copy this file to .env and fill in real values. .env is gitignored — this
# file is the one that's checked in, so keep it in sync whenever a new env
# var is introduced.

# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&channel_binding=require"
PORT="3000"
NODE_ENV="development"

# Comma separated allowlist of browser origins. Required, and no wildcard: this
# API sends credentials, and browsers reject '*' with credentials, so a wildcard
# would break every authenticated call rather than relaxing anything.
CORS_ORIGINS="http://localhost:3001"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="PixelVega <no-reply@example.com>"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Bootstraps the single SYSTEM_ADMIN account on first boot (no-op once any user exists).
SEED_ADMIN_EMAIL=""
SEED_ADMIN_NAME=""

# Slack app "Bot User OAuth Token" (starts with xoxb-) — every SlackService call
# no-ops safely if this is missing/invalid, so the feature can be left unset.
SLACK_BOT_TOKEN=""
# Channel ID (not name) of the company-wide feed channel that combined daily
# plan/wrap-up messages post to.
SLACK_DAILY_FEED_CHANNEL_ID=""

# Claude API key for the AI scope checker, project summary, and status report
# features (see docs/features/ai-integration/DESIGN.MD, gitignored).
ANTHROPIC_API_KEY=""
# Connection string for the BullMQ job queue backing the scope checker and
# status report generation (e.g. Upstash, Redis Cloud, or a local instance
# in development). Unlike SLACK_BOT_TOKEN above, this one is not optional,
# AiModule's queue will not work without a reachable Redis.
REDIS_URL=""

# Where a password reset link points. better-auth mints the token, but the page
# that collects the new password lives in the dashboard, so the link has to
# leave this origin. Optional: falls back to the first CORS_ORIGINS entry.
APP_URL="http://localhost:3001"
# Shared secret identifying a first party server rendered caller. Such a caller
# may bypass the per IP throttle on routes that have not tightened their own
# limit, and may forward the real visitor's IP so limits land per visitor rather
# than per SSR egress address. Optional: unset means the bypass never triggers.
INTERNAL_API_SECRET=""
# Set to "true" to turn OFF better-auth's origin check, which is CSRF
# protection. For a local Postman session only. Deliberately opt in by explicit
# value: it used to be inferred from NODE_ENV, which left staging unprotected.
AUTH_DISABLE_ORIGIN_CHECK=""
