# Copy this file to .env and fill in real values.
#
# .env is gitignored; THIS file is the one that is checked in, so keep the two
# in step. src/env.validate.ts is the enforcement: it runs as the first
# statement of bootstrap() and fails the boot on a missing or malformed value,
# so a mistake here surfaces at startup rather than at first use.
#
# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED. The app will not start without these.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV="development"
PORT=5050

# PostgreSQL. Prisma does not read this file on its own: prisma.config.ts does
# `import 'dotenv/config'` for the CLI. See https://pris.ly/prisma-config-env-vars
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pixelvega_dev"

# Comma separated allowlist of browser origins. Used for BOTH the HTTP CORS
# layer and better-auth's trusted origins, so the dashboard must appear here or
# sign-in fails. No wildcard: this API sends credentials, and browsers reject
# '*' with credentials, which breaks every authenticated call rather than
# relaxing anything.
CORS_ORIGINS="http://localhost:3000"

# Signing key for sessions and password reset tokens. At least 32 characters.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Where this API is reachable. better-auth reads it from the environment
# itself, which is why nothing in src/ references it directly.
BETTER_AUTH_URL="http://localhost:5050"

# The single SYSTEM_ADMIN bootstrapped on first boot. A no-op once any user
# exists, and no API path can ever create a second one.
SEED_ADMIN_EMAIL="admin@pixelvega.com"
SEED_ADMIN_NAME="System Admin"

# SMTP, for the invite and password reset emails. Both are transactional and
# there is no queue in front of them, so a dead provider means no invites.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="PixelVega <noreply@pixelvega.com>"

# Cloudinary, for avatars and project documents. Uploads use resource_type
# 'auto', so any file type is stored correctly without configuration here.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Redis, backing the BullMQ queue for the AI scope check and status report.
# Not optional: those two features have no synchronous fallback.
REDIS_URL="redis://localhost:6379"

# Claude, for the scope checker, project summary and status report.
# See docs/features/ai-integration/DESIGN.MD.
ANTHROPIC_API_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL. Each has a documented behaviour when unset.
# ─────────────────────────────────────────────────────────────────────────────

# Where an email should send someone: the dashboard, never this API. Both the
# password reset link and the invite's sign-in link use it. Unset falls back to
# the first CORS_ORIGINS entry, which is correct in every environment where the
# dashboard is listed first.
APP_URL="http://localhost:3000"

# Shared secret identifying a first party server rendered caller. Such a caller
# may bypass the per IP throttle on routes that have NOT tightened their own
# limit, and may forward the real visitor's IP so limits land per visitor
# rather than per SSR egress address. Unset means the bypass never triggers, so
# forgetting it is safe: everything stays throttled.
INTERNAL_API_SECRET=""

# Slack bot token (starts with xoxb-). Every SlackService call no-ops safely
# when this is missing or invalid, so the whole integration can be left off.
SLACK_BOT_TOKEN=""
# Channel ID, not name, of the company wide feed that combined daily plan and
# wrap-up messages post to.
SLACK_DAILY_FEED_CHANNEL_ID=""

# Set to "true" to turn OFF better-auth's origin check, which is CSRF
# protection. For a local Postman or curl session only, since those send no
# Origin header. Deliberately opt in by explicit value: this used to be
# inferred from NODE_ENV, which meant every environment that was not exactly
# "production", staging included, ran with no origin check at all.
AUTH_DISABLE_ORIGIN_CHECK=""

# Attempts per minute, per IP, on sign-in and the three password routes.
#
# Unset means 5, which is the production value: it is the defence against
# password guessing, and the reason the auth controller can skip Nest's general
# throttle tiers.
#
# Worth raising in local development, and not because anyone is careless.
# better-auth counts per IP, and locally the browser, the Next route guard and
# server-side rendering all arrive as 127.0.0.1, so one page load can spend
# several of the five. Signing in as four roles in a row to check what each sees
# exhausts it in seconds, and the failure then reads as "wrong password".
#
# The counters are in memory, so restarting the backend also clears a lockout.
# AUTH_SENSITIVE_RATE_LIMIT_MAX=50

